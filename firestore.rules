rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/config/admins)
        && get(/databases/$(database)/documents/config/admins).data.uids is list
        && request.auth.uid in get(/databases/$(database)/documents/config/admins).data.uids;
    }

    match /config/admins {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /subjects/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /grades/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /topics/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /worksheets/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
