rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/config/admins)
        && request.auth.uid in get(/databases/$(database)/documents/config/admins).data.uids;
    }

    match /config/admins {
      allow read: if request.auth != null && request.auth.uid in resource.data.uids;
      allow write: if false;
    }

    match /subjects/{documentId} {
      allow read: if true;
      allow write: if false;
    }

    match /grades/{documentId} {
      allow read: if true;
      allow write: if false;
    }

    match /topics/{documentId} {
      allow read: if true;
      allow write: if false;
    }

    match /worksheets/{documentId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
