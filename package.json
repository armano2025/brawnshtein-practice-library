{
  "name": "brawnshtein-practice-library",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "lint": "eslint . --max-warnings 0",
    "test:search": "tsx scripts/testSearch.ts",
    "cy:run": "cypress run --e2e",
    "seed": "tsx scripts/seedFirestore.ts",
    "seed:dry-run": "tsx scripts/seedFirestore.ts --dry-run"
  },
  "dependencies": {
    "firebase": "^11.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "cypress": "^15.17.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "firebase-admin": "^13.0.0",
    "globals": "^15.12.0",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.1"
  }
}
